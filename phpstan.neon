includes:
    - ../../vendor/larastan/larastan/extension.neon
    - ../../vendor/thecodingmachine/phpstan-safe-rule/phpstan-safe-rule.neon

parameters:
    level: max

    paths:
        - ./app
        - ./database

    excludePaths:
        - ./vendor (?)
        - ./tests (?)
        - ./app_old (?)

    

    
